<% content_for :title, "Orders" %>

<div class="w-full">
  <h1 class="font-bold text-3xl">Orders of <%= Current.user.name %></h1>

  <% if @orders.any? %>
    <div>
      <% @orders.each do |order| %>
        <div>
          <h2 class="font-bold">Order No. <%= order.id %></h2>
          <p>Total: <%= number_to_currency(order.total_price) %></p>

          <h3>Line items</h3>
          <ul>
            <% order.line_items.each do |line_item| %>
              <li>
                <%= line_item.quantity %>
                <%= line_item.product.title %>
                <%= number_to_currency(line_item.total_price) %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>No orders found.</p>
  <% end %>

</div>
